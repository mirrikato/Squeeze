				</dict>
				<key>ActionBundlePath</key><string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key><string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key><string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1
PREF="$HOME/Library/Application Support/Squeeze"
LOG="$HOME/Library/Logs/Squeeze.log"; mkdir -p "$HOME/Library/Logs"
{
  echo "---- $(date) Squeeze v1.0 ----"
  echo "brew: $(command -v brew || echo missing)"
  echo "gs: $(command -v gs || echo missing)"
  echo "pngquant: $(command -v pngquant || echo missing)"
  echo "declined marker: $([ -f "$PREF/declined" ] &amp;&amp; echo yes || echo no)"
} &gt;&gt;"$LOG"
# If Homebrew exists but the helpers don't, offer once to install them.
if command -v brew &gt;/dev/null 2&gt;&amp;1 &amp;&amp; [ ! -f "$PREF/declined" ] &amp;&amp; \
   { ! command -v gs &gt;/dev/null 2&gt;&amp;1 || ! command -v pngquant &gt;/dev/null 2&gt;&amp;1; }; then
  answer=$(osascript 2&gt;&gt;"$LOG" &lt;&lt;'AS'
tell application "System Events"
  activate
  set r to display dialog "Homebrew is installed on this Mac. Squeeze can use it to add Ghostscript and pngquant for sharper PDFs and smaller PNGs. Install them now? It takes about a minute." buttons {"Not Now", "Install"} default button "Install" with title "Squeeze"
  return button returned of r
end tell
AS
)
  echo "dialog answer: '$answer'" &gt;&gt;"$LOG"
  if [ "$answer" = "Install" ]; then
    osascript -e 'display notification "Installing helpers, this may take a minute..." with title "Squeeze"'
    if brew install ghostscript pngquant &gt;&gt;"$LOG" 2&gt;&amp;1; then
      osascript -e 'display notification "Helpers installed" with title "Squeeze"'
    else
      osascript -e 'display notification "Install failed, using built-in macOS tools" with title "Squeeze"'
    fi
  elif [ "$answer" = "Not Now" ]; then
    mkdir -p "$PREF" &amp;&amp; touch "$PREF/declined"
  fi
fi
LOG="$HOME/Library/Logs/Squeeze.log"
saved=0
for f in "$@"; do
  ext=$(echo "${f##*.}" | tr '[:upper:]' '[:lower:]')
  base="${f%.*}"
  out=""
  case "$ext" in
    png)
      if command -v pngquant &gt;/dev/null 2&gt;&amp;1; then
        out="$base-small.png"
        pngquant --quality=65-85 --skip-if-larger --output "$out" "$f" 2&gt;&gt;"$LOG" || true
      elif sips -g hasAlpha "$f" 2&gt;/dev/null | grep -q "hasAlpha: yes"; then
        # transparent PNG: keep PNG so transparency survives, only downscale huge ones
        out="$base-small.png"
        sips -Z 2560 "$f" --out "$out" &gt;/dev/null 2&gt;&gt;"$LOG"
      else
        # no transparency: JPEG is far smaller and looks the same
        out="$base-small.jpg"
        sips -Z 2560 -s format jpeg -s formatOptions 80 "$f" --out "$out" &gt;/dev/null 2&gt;&gt;"$LOG"
      fi ;;
    jpg|jpeg|heic|heif|tif|tiff)
      out="$base-small.jpg"
      sips -Z 2560 -s format jpeg -s formatOptions 75 "$f" --out "$out" &gt;/dev/null 2&gt;&gt;"$LOG" ;;
  esac
  if [ -n "$out" ] &amp;&amp; [ -f "$out" ] &amp;&amp; [ "$(stat -f%z "$out")" -lt "$(stat -f%z "$f")" ]; then
    saved=$((saved + 1))
  else
    [ -n "$out" ] &amp;&amp; rm -f "$out"
  fi
done
osascript -e "display notification \"Squeezed $saved of $# image(s)\" with title \"Squeeze\""</string>
					<key>CheckedForUserDefaultShell</key><true/>
					<key>inputMethod</key><integer>1</integer>
					<key>shell</key><string>/bin/bash</string>
					<key>source</key><string></string>
